# ─── Notes ─────────────────────────────────────────────────────────────────────
# Do NOT prefix variables with NEXT_PUBLIC_ unless they need to be exposed to client components.
# Server-side API routes access non-prefixed environment variables securely.

# ─── Backend Storage & Express API Configuration ───────────────────────────────
# URL and API Key of the C3 Backend Express server handling image storage and processing.
# Client-exposed variables (used in client components if needed):
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_KEY=your_backend_api_key_here

# Server-side variables (used securely inside Next.js Route Handlers under src/app/api/):
BACKEND_API_URL=http://localhost:5000
BACKEND_API_KEY=your_backend_api_key_here

# ─── Database Configuration ────────────────────────────────────────────────────
# Connection string for your MongoDB Atlas cluster (or local instance).
# Example: mongodb+srv://user:pass@cluster.mongodb.net/c3?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/C3

# ─── Admin Dashboard Security ──────────────────────────────────────────────────
# Secret used to sign/verify admin JWT session tokens (jose library).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=generate_a_random_64_character_hex_string_here

# Password for admin login
ADMIN_PASSWORD=change_this_to_a_strong_admin_password

# ─── UPI Configuration ─────────────────────────────────────────────────────────
# Public UPI ID to display on the payment step (exposed to client side)
NEXT_PUBLIC_UPI_ID=c3club@upi

# ─── SMTP Configuration (for welcome & submission emails) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# ─── Event Configuration ───────────────────────────────────────────────────────
# Links for accepted/shortlisted candidates
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/mock-digital-india
HACKATHON_REGISTRATION_LINK=https://c3-digital-india-hackathon.example.com
