# ─── Shared Config ─────────────────────────────────────────────────────────────
# MongoDB, SMTP, and API_KEY are documented in snist-website-bn/.env.example.
# Copy those values here — both FN and BN need their own .env file.

# ─── Admin Dashboard ──────────────────────────────────────────────────────────
ADMIN_PASSWORD=change_this_to_a_strong_admin_password
ADMIN_JWT_SECRET=generate_a_random_64_character_hex_string_here

# ─── Backend API URL (for FN → BN file upload relay) ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── UPI Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_UPI_ID=c3club@upi

# ─── Event Configuration ──────────────────────────────────────────────────────
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your-group-invite
HACKATHON_REGISTRATION_LINK=https://example.com/register
